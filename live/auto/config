#!/bin/sh
# NOTE:
#   live-build reads this file on 'lb config', so it stays in shell (live-build's format).
#   Every option here ends up in config/, see 'man lb_config'.
#
#   Boot parameters:
#     no 'quiet'                   Kernel and systemd print every step, a slow boot never looks like a hang.
#     live-config.nottyautologin   Disables the default autologin of the 'user' account,
#                                  tty2 logs in as root via the getty override in includes.chroot.
#     live-config.hostname         The name avahi announces, the phone opens http://tabula-rasa.local/.
#
#   Size (the defaults of live-build would add about half a gigabyte):
#     --firmware-chroot/-binary false   Not every firmware package, only the Wi-Fi ones from the package list.
#     --apt-indices false               No apt package lists in the image, the live system never installs.
#   Recommended packages stay on: without them the live system booted with errors.
#     --chroot-squashfs-compression-*   xz, smaller than the default at the cost of a slower build.

set -e

lb config noauto \
    --distribution trixie \
    --architectures amd64 \
    --archive-areas "main contrib non-free non-free-firmware" \
    --binary-images iso-hybrid \
    --uefi-secure-boot enable \
    --debian-installer none \
    --memtest none \
    --firmware-chroot false \
    --firmware-binary false \
    --apt-indices false \
    --apt-source-archives false \
    --chroot-squashfs-compression-type xz \
    --image-name linux-tabula-rasa \
    --iso-application "Linux Tabula Rasa" \
    --iso-volume "TABULA_RASA" \
    --bootappend-live "boot=live components live-config.nottyautologin live-config.hostname=tabula-rasa" \
    "${@}"
