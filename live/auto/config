#!/bin/sh
# NOTE:
#   live-build reads this file on 'lb config', so it stays in shell (live-build's format).
#   Every option here ends up in config/, see 'man lb_config'.
#
#   Boot parameters:
#     live-config.nottyautologin   Disables the default autologin of the 'user' account,
#                                  tty1 logs in as root via the getty override in includes.chroot.

set -e

lb config noauto \
    --distribution trixie \
    --architectures amd64 \
    --archive-areas "main contrib non-free non-free-firmware" \
    --binary-images iso-hybrid \
    --uefi-secure-boot enable \
    --debian-installer none \
    --memtest none \
    --image-name linux-tabula-rasa \
    --iso-application "Linux Tabula Rasa" \
    --iso-volume "TABULA_RASA" \
    --bootappend-live "boot=live components quiet live-config.nottyautologin" \
    "${@}"
