# Keeps docs, man pages and foreign translations out of every package installed into the live system.
# Copied in before the package lists are installed (includes.chroot_before_packages).
# The packages of the base system came earlier, hooks/live/0300-slim-down.hook.chroot cleans those.

path-exclude /usr/share/doc/*
path-include /usr/share/doc/*/copyright
path-exclude /usr/share/man/*
path-exclude /usr/share/info/*
path-exclude /usr/share/lintian/*
path-exclude /usr/share/locale/*
path-include /usr/share/locale/locale.alias
path-include /usr/share/locale/en*
path-exclude /usr/lib/chromium/locales/*
path-include /usr/lib/chromium/locales/en-US.pak
