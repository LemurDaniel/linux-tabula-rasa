# Installed without recommends (auto/config), so everything the system needs is listed here.

# Live system
live-boot
live-config
live-config-systemd

# Wipe tools
hdparm
nvme-cli
sg3-utils
smartmontools
util-linux

# Data views: deleted files via file system metadata
sleuthkit

# PowerShell runtime (installed by hooks/live/0100-install-pwsh.hook.chroot)
ca-certificates
curl
libicu76
unzip

# Kiosk: cage (Wayland kiosk compositor) + Chromium on tty1
# Mesa renders on Intel/AMD GPUs, without GPU firmware the kiosk falls back to software rendering.
cage
chromium
chromium-sandbox
libgl1-mesa-dri
fonts-dejavu-core
fonts-noto-color-emoji

# Network: DHCP on LAN, hotspot (wpasupplicant), mDNS (tabula-rasa.local), QR codes
network-manager
wpasupplicant
dnsmasq-base
avahi-daemon
iproute2
iw
wireless-regdb
qrencode

# Firmware for common Wi-Fi chips (non-free-firmware), no GPU firmware
firmware-iwlwifi
firmware-realtek
firmware-atheros
firmware-mediatek
firmware-brcm80211

# Console
console-setup
kbd
less
locales
pciutils
usbutils
