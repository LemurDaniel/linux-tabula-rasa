# Opens the Wi-Fi hotspot at boot as the first way in, LAN (NetworkManager) is the second.
[Unit]
Description=Tabula Rasa hotspot
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/pwsh -NoLogo -NoProfile -Command "Import-Module /opt/tabula-rasa/TabulaRasa.Web; Start-TabulaRasaWebHotspot -Verbose"

[Install]
WantedBy=multi-user.target
