# Kiosk on tty1: cage (Wayland kiosk) with Chromium on the local web UI.
# -s asks cage to allow VT switching (Ctrl+Alt+F2), the start screen also has a button for the text menu.
# Chromium starts only once the web server answers: in kiosk mode it never reloads a failed page.
# Three crashes within a minute (no GPU, no display) -> tabula-rasa-fallback switches to tty2.
[Unit]
Description=Tabula Rasa kiosk
After=systemd-user-sessions.service tabula-rasa-server.service
Wants=tabula-rasa-server.service
Conflicts=getty@tty1.service
After=getty@tty1.service
StartLimitIntervalSec=60
StartLimitBurst=3
OnFailure=tabula-rasa-fallback.service

[Service]
Type=simple
User=kiosk
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
# Without GPU firmware (not shipped) the GPU driver may not load, software rendering keeps the kiosk up.
Environment=WLR_RENDERER_ALLOW_SOFTWARE=1
# Waits up to 3 minutes for the web server and prints the progress on tty1, '+' runs it as root.
ExecStartPre=+/usr/local/sbin/tabula-rasa-wait-server
TimeoutStartSec=240
ExecStart=/usr/bin/cage -s -- /usr/bin/chromium --enable-logging=stderr --v=0 --kiosk --no-first-run --noerrdialogs --disable-translate --disable-features=Translate --password-store=basic --ozone-platform=wayland --app=http://localhost/
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical.target
