#!/bin/sh
# NOTE:
#   live-build runs this hook inside the chroot during 'lb build', so it stays in shell.
#   Installs PowerShell from the official release tarball (checked against hashes.sha256)
#   and the modules PwshSpectreConsole (text menu) and Pode (web server) for all users.

set -e

PWSH_VERSION="7.6.8"
SPECTRE_VERSION="2.6.3"
PODE_VERSION="2.14.1"

PWSH_ARCHIVE="powershell-${PWSH_VERSION}-linux-x64.tar.gz"
PWSH_RELEASE_URL="https://github.com/PowerShell/PowerShell/releases/download/v${PWSH_VERSION}"
PWSH_HOME="/opt/microsoft/powershell/7"

# Download and verify the release tarball.
cd /tmp
curl -fsSL -o "${PWSH_ARCHIVE}" "${PWSH_RELEASE_URL}/${PWSH_ARCHIVE}"
curl -fsSL -o hashes.sha256 "${PWSH_RELEASE_URL}/hashes.sha256"
# hashes.sha256 is UTF-16LE with CRLF and holds '<hash> *<file>' lines.
# The '*' marks binary mode, sha256sum reads it as is.
iconv -f UTF-16 -t UTF-8 hashes.sha256 | tr -d '\r' | grep " \*${PWSH_ARCHIVE}\$" | sha256sum -c -

# Install and link pwsh.
mkdir -p "${PWSH_HOME}"
tar -xzf "${PWSH_ARCHIVE}" -C "${PWSH_HOME}"
chmod +x "${PWSH_HOME}/pwsh"
ln -sf "${PWSH_HOME}/pwsh" /usr/bin/pwsh
rm -f "${PWSH_ARCHIVE}" hashes.sha256

# Install the modules for all users, straight from the gallery package (a .nupkg is a zip).
# Inside the chroot pwsh loads none of its bundled modules (neither Install-PSResource nor
# Expand-Archive are found), so unzip extracts and the manifest proves the module is in place.
install_module() {
    target="/usr/local/share/powershell/Modules/$1/$2"
    mkdir -p "${target}"
    curl -fsSL -o "/tmp/$1.nupkg" "https://www.powershellgallery.com/api/v2/package/$1/$2"
    unzip -q -o "/tmp/$1.nupkg" -d "${target}"
    rm -rf "${target}/_rels" "${target}/package" "${target}/[Content_Types].xml" "/tmp/$1.nupkg"
    test -f "${target}/$1.psd1"
}

install_module PwshSpectreConsole "${SPECTRE_VERSION}"
install_module Pode "${PODE_VERSION}"
